{{!
    @template mod_seledascorm/admin_embedded_editor
}}
<div class="mod_seledascorm-admin-embedded-editor">
    <div class="card">
        <div class="card-body">
            {{#active_source_bundled}}
                <span class="badge badge-success bg-success mr-2 me-2">
                    {{#str}} editorbundledsource, mod_seledascorm {{/str}}
                </span>
                <span class="text-muted small">
                    {{#str}} editorbundleddesc, mod_seledascorm {{/str}}
                </span>
            {{/active_source_bundled}}

            {{#active_source_none}}
                <span class="badge badge-danger bg-danger mr-2 me-2">
                    {{#str}} noeditorinstalled, mod_seledascorm {{/str}}
                </span>
                <span class="text-muted small">
                    {{#str}} editornotinstalleddesc, mod_seledascorm {{/str}}
                </span>
            {{/active_source_none}}

            <p class="text-muted small mt-3 mb-0">
                {{#str}} editormanagementhelp, mod_seledascorm {{/str}}
            </p>
        </div>
    </div>
</div>
